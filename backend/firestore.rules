rules_version = '2';

// IronSync Firestore Security Rules
// Owner: jaikanth (backend). These rules are the REAL protection for our data —
// the client can't be trusted, so access control lives here.
//
// Golden rules:
//  - A user's profile, measurements, and HEALTH NOTES are private to that user.
//  - Health data must NEVER be readable by the friend group.
//  - Only explicitly-shared data (group PRs, streak board, supplement posts) is group-visible.
//
// This is a starting point — tighten as features land. Test with the Firebase emulator.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ---- Users & their PRIVATE sub-collections ----
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Measurements & health notes: owner-only, no exceptions.
      match /measurements/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /healthNotes/{docId} {
        allow read, write: if isOwner(userId);
      }
      // Workouts, PRs, nutrition: owner-only for now.
      match /{sub}/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ---- Username registry ----
    // usernames/{normalized} -> { uid }. Readable by anyone signed in so the
    // sign-up screen can tell you a handle is taken; claimable only by the
    // person taking it, and never reassignable to someone else.
    match /usernames/{name} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ---- Public profiles ----
    // Name, username and avatar — the bits other people legitimately need to
    // render you in a list. Everything else about a user (email, weight, goals,
    // health notes) stays behind the owner-only rule above.
    match /publicProfiles/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // ---- A friend's workouts ----
    // 1-to-1 friends can see each other's training, which is the whole point of
    // the crew. Two gates, both enforced here rather than in the client:
    //   · the workout itself must be shared ('friends' or 'everyone'), and
    //   · the owner must not have switched stats sharing off in Settings.
    // Everything else under users/{uid} — measurements, health notes, nutrition —
    // stays owner-only via the catch-all above.
    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }
    function areFriends(a, b) {
      return exists(/databases/$(database)/documents/friendships/$(pairId(a, b)));
    }
    function sharesStats(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.statsVisibleToFriends != false;
    }
    match /users/{userId}/workouts/{workoutId} {
      // A query must constrain `visibility` itself, or it's rejected outright —
      // see getFriendWorkouts in app/src/services/workouts/workouts.ts.
      allow read: if isOwner(userId)
                  || (isSignedIn()
                      && resource.data.visibility in ['friends', 'everyone']
                      && areFriends(request.auth.uid, userId)
                      && sharesStats(userId));
      allow write: if isOwner(userId);
    }

    // ---- Shared exercise library: everyone signed-in reads; users add their own customs ----
    // (Seeded exercises are written via the Admin SDK / CLI, which bypasses these rules.)
    match /exercises/{exerciseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.isCustom == true
                    && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    // ---- Public Food Database ----
    match /foods/{foodId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---- Training plans: public plans are readable by all; private only by owner ----
    match /plans/{planId} {
      allow read: if isSignedIn()
                  && (resource.data.visibility == 'public'
                      || resource.data.createdBy == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
      // Saving someone else's public plan bumps a shared counter — allow ANY
      // signed-in user to touch this one field only (owner already covered above).
      allow update: if isSignedIn()
                    && resource.data.visibility == 'public'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['savedCount']);
    }

    // ---- Friends (1-to-1) ----
    // Requests: sender creates; either party can read/delete (accept/decline).
    match /friendRequests/{reqId} {
      allow read, delete: if isSignedIn()
                          && (request.auth.uid == resource.data.fromId
                              || request.auth.uid == resource.data.toId);
      allow create: if isSignedIn() && request.resource.data.fromId == request.auth.uid;
    }
    // Friendships: keyed by sorted pair; either member can read/write/delete.
    // ⚠️ Add-by-email currently queries the users collection (owner-only reads),
    //    which works in test mode. For production, look users up via a Cloud
    //    Function or a minimal public-profiles collection instead.
    match /friendships/{pairId} {
      allow read, write: if isSignedIn() && request.auth.uid in resource.data.members;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.members;
    }

    // ---- Groups (crews) ----
    match /groups/{groupId} {
      // Readable by any signed-in user, so someone can look a crew up by invite code to join.
      allow read: if isSignedIn();
      // Create your own crew (you must be its creator and a member).
      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.auth.uid in request.resource.data.members;
      // Update: existing members can edit; a non-member may add THEMSELVES (join by code).
      // ⚠️ MVP TRADE-OFF: this lets a signed-in user add themselves to any groupId they know.
      // Harden on Blaze by moving "join" into a Cloud Function that verifies the invite code.
      allow update: if isSignedIn()
                    && (request.auth.uid in resource.data.members
                        || request.auth.uid in request.resource.data.members);
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      // Boards & supplement posts: members read; members write (client-side board sync on Spark).
      // ⚠️ On Blaze, tighten leaderboard/streakBoard `write` to `false` and let the
      //    Cloud Function (Admin SDK) own them — see backend/functions/.
      function isMember() {
        return isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
      }
      match /{sub}/{docId} {
        allow read, write: if isMember();
      }
    }

    // ---- Communities ----
    match /communities/{communityId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.adminIds ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'trainingNowCount'])
      );
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      match /members/{uid} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (request.auth.uid == uid || request.auth.uid in get(/databases/$(database)/documents/communities/$(communityId)).data.adminIds);
      }

      match /requests/{uid} {
        allow read, write: if isSignedIn() && (request.auth.uid == uid || request.auth.uid in get(/databases/$(database)/documents/communities/$(communityId)).data.adminIds);
      }

      match /challenges/{challengeId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/communities/$(communityId)).data.adminIds;
        allow update: if isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantIds']);

        match /progress/{uid} {
          allow read: if isSignedIn();
          allow write: if isSignedIn() && request.auth.uid == uid;
        }
      }

      match /posts/{postId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
        allow update: if isSignedIn() && (
          resource.data.authorId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'celebrateCount', 'commentCount'])
        );
        allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
      }

      match /achievements/{achId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      }
    }

    // ---- Duo/Group Live Sessions ----
    match /duoSessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.creatorId ||
        request.auth.uid in resource.data.participants.keys() ||
        request.auth.uid in request.resource.data.participants.keys()
      );
      allow delete: if isSignedIn() && resource.data.creatorId == request.auth.uid;

      match /participants/{uid} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == uid;

        match /sets/{setId} {
          allow read: if isSignedIn();
          allow write: if isSignedIn() && request.auth.uid == uid;
        }
      }
    }

    // ---- Session Invites ----
    match /sessionInvites/{inviteId} {
      allow read, update, delete: if isSignedIn() && (
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId
      );
      allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid;
    }

    // ---- Notifications ----
    match /notifications/{notifId} {
      allow read, update, delete: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.fromUserId == request.auth.uid);
    }
  }
}
