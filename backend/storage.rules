rules_version = '2';

// IronSync Cloud Storage rules
// Owner: jaikanth (backend).
//
// The only thing stored today is profile photos. They're readable by any
// signed-in user — friends need to see each other's avatars, and a photo you
// put on your profile is not private data — but writable only by their owner.

service firebase.storage {
  match /b/{bucket}/o {

    // avatars/{userId} — one photo per user, overwritten on change.
    match /avatars/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   // Keep a stray video or a huge upload out of the bucket.
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Nothing else is stored yet, and nothing should be written by accident.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
